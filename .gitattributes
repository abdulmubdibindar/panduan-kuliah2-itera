# Git menebak sendiri mana berkas teks, lalu menyimpannya
# dengan akhir baris LF di dalam repo
* text=auto

# Format inti proyek — dinyatakan tegas agar tidak bergantung pada tebakan
*.qmd  text
*.md   text
*.typ  text
*.yml  text
*.svg  text

# Berkas biner — akhir barisnya jangan pernah disentuh
*.pdf   binary
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary
*.woff  binary
